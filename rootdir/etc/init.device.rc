service vendor.device-sh /vendor/bin/init.device.sh
    user root
    group root
    oneshot

on early-init
    exec_start vendor.device-sh
    setprop ro.boot.product.hardware.sku ${ro.separate.soft}

    # Mount ODM moved files
    mount overlay overlay /vendor/etc/acdbdata ro lowerdir=/odm/etc/acdbdata:/vendor/etc/acdbdata
    mount overlay overlay /vendor/firmware ro lowerdir=/odm/firmware:/vendor/firmware

    # WiFi NV
    mount overlay overlay /vendor/firmware/wlan/prima ro lowerdir=/vendor/firmware/wlan/${ro.vendor.wifi.nv}:/vendor/firmware/wlan/prima

    # Miscellaneous variant specific files
    mount overlay overlay /vendor/etc/sensors ro lowerdir=/odm/etc/sensor_def/${ro.separate.soft}:/vendor/etc/sensors
