cc_binary {
    name: "qkmloader",
    srcs: ["keymaster_qcom.cpp"],
    vendor: true,
    cflags: [
        "-fvisibility=hidden",
        "-Wno-error",
        "-Wall",
    ],
    shared_libs: [
        "libbase",
        "libdl",
        "liblog",
    ],
}
